# Copy to .env.local for local development; never commit populated secrets.
RESEND_API_KEY=
# Exact authorized sender address from your verified Resend domain. No default sender.
CONTACT_FROM_EMAIL=
# Exact public origin, without a trailing slash. Locally use the origin printed by Vite.
CONTACT_ORIGIN=http://localhost:5173
# Public Turnstile widget key. Configure the site hostname in the Cloudflare dashboard.
TURNSTILE_SITE_KEY=
# Secret Turnstile validation key; server-only.
TURNSTILE_SECRET_KEY=
